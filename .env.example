# ====================================================================
# SODE Universal Admin Panel - Environment Template (.env.example)
# Copy this file to .env and fill in your actual environment secrets.
# ====================================================================

# Database Configuration
DB_HOST=localhost
DB_PORT=3307
DB_NAME=admin_glob_db
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=admin_glob_db
# DB_USER=admin_glob_db
# DB_PASS=UHfKyrokkr5u1*5&
# DB_CHARSET=utf8mb4

# Central Lead CRM API Credentials (mysode.com)
CRM_API_URL=https://api.crm.mysode.com/api/lead/apicreated
CRM_API_KEY=your_crm_api_key_here
CRM_SECRET=your_crm_secret_key_here

# Brevo (Sendinblue) Contacts API Credentials
BREVO_API_URL=https://api.brevo.com/v3/contacts
BREVO_API_KEY=your_brevo_api_key_here

# Gallabox WhatsApp Webhook URL
GALLABOX_WEBHOOK_URL=https://server.gallabox.com/accounts/.../integrations/genericWebhook/.../webhook

# Redis In-Memory Cache (Local Server)
REDIS_ENABLED=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASS=
REDIS_TIMEOUT=1.5
REDIS_PREFIX=sode:
REDIS_DEFAULT_TTL=86400

